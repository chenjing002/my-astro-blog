---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .filter(project => !project.data.draft)
  .slice(0, 5);

const externalProjects = [
  {
    title: "aimunger",
    description: "提升严肃投研阅读效率（基于 Unlimited-OCR、VibeVoice、LLM wiki）",
    href: "https://aimunger.com/",
  },
  {
    title: "LLM Reader",
    description: "见微知著，洞察秋毫",
    href: "https://chenjing002.github.io/llm-reader/",
  },
];

const allwork = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0,SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);

---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-2xl text-[#100f0f] dark:text-white">
      Hi，我是陈晶 <span class="text-2xl">👋</span> 
    </h4>
    <div class="space-y-8">
      <section>
        <article class="space-y-4">
            <img class="ml-0 pt-4" src="../avatar.svg" alt="avatar" >          
            <p class="space-y-3">
              <span class="block">我致力于成为优秀的技术型产品经理，创造有意思/有价值的商业产品和服务。我从事过交互设计师和产品经理的工作。</span>
              <span class="block">我热爱创造，边做边学，努力迈出的每一小步，胜过从未开始的伟大梦想。</span>
              <span class="block">我喜欢<Link href="/blog/04-my-booklists" class="!font-normal">阅读</Link>，对AI、价值投资感兴趣。查理·芒格的智慧和生活哲学，对我影响深刻，他是我的榜样。每过完一天，要努力比早上醒来时更聪明点。</span>
            </p>
          <!-- <p class="animate">
            Visit
            <Link href="https://github.com/markhorn-dev/astro-nano" aria-label="Astro Nano on Github" external>
              Astro Nano on Github
            </Link>
            to fork the repository, read the docs or one-click deploy on Vercel or Netlify. 
          </p> -->
        </article>
      </section>

      <div class="border-t border-black/10 dark:border-white/10"></div>
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <Link href="/projects">
            <h5 class="text-[18.205px] text-[#6f6e69] dark:text-white font-normal hover:text-orange-600 hover:dark:text-[#3aa99f]">项目</h5>
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {externalProjects.map((ep) => (
            <li>
              <a
                href={ep.href}
                class="relative group flex flex-nowrap py-3 px-2 pr-5 text-black/70 dark:text-white/90 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out"
              >
                <div class="flex flex-col flex-1 truncate">
                  <div class="font-semibold">
                    {ep.title}
                  </div>
                  <div class="text-sm pt-1">
                    {ep.description}
                  </div>
                </div>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  class="absolute top-1/2 right-2 -translate-y-1/2 size-5 stroke-2 fill-none stroke-current"
                >
                  <line x1="5" y1="12" x2="19" y2="12" class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out" />
                  <polyline points="12 5 19 12 12 19" class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out" />
                </svg>
              </a>
            </li>
          ))}
          {projects.map(project => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>

      <div class="border-t border-black/10 dark:border-white/10"></div>
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <Link href="/blog">
            <h5 class="text-[18.205px] text-[#6f6e69] dark:text-white font-normal hover:text-orange-600 hover:dark:text-[#3aa99f]">文章</h5>
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <!-- <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Work Experience
          </h5>
          <Link href="/work">
            See all work
          </Link>
        </div>
        <ul class="flex flex-col space-y-4">
          {work.map(entry => (
            <li>
              <div class="text-sm opacity-75">
                {dateRange(entry.data.dateStart, entry.data.dateEnd)}
              </div>
              <div class="font-semibold text-black dark:text-white">
                {entry.data.company}
              </div>
              <div class="text-sm opacity-75">
                {entry.data.role}
              </div>
              <article>
                <entry.Content />
              </article>
            </li>
          ))}
        </ul>
      </section> -->

      <div class="border-t border-black/10 dark:border-white/10"></div>
      <section class="animate space-y-4">
        <h5 class="text-[18.205px] text-[#6f6e69] dark:text-white font-normal">联系</h5>
        <article>
          <p>
            我喜欢认识有趣的新朋友。我会回复每封邮件，来打个招呼吧！
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
