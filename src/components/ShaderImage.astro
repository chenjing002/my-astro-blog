---
// 为图片添加一个流动的 simplex noise 着色器背景
// 移植自 https://shaders.paper.design/simplex-noise 的算法
interface Props {
  src: string;
  alt: string;
  class?: string;
  /** 渐变色（16 进制），噪声值在这些颜色间循环映射 */
  colors?: string[];
  /** 每种颜色之间的阶梯数（越小色带越明显） */
  stepsPerColor?: number;
  /** 色带边缘柔和度，0 = 硬边 */
  softness?: number;
  /** 图案缩放，越小图案越密 */
  scale?: number;
  /** 动画速度 */
  speed?: number;
}

const {
  src,
  alt,
  class: className,
  colors = ["#4449cf", "#ffd1e0", "#f94346", "#ffd36b", "#ffffff"],
  stepsPerColor = 2,
  softness = 0,
  scale = 4,
  speed = 0.3,
} = Astro.props;

const config = JSON.stringify({ colors, stepsPerColor, softness, scale, speed });
---

<div class="shader-image relative overflow-hidden rounded-xl p-4 sm:p-8" data-shader={config}>
  <canvas class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
  <img
    src={src}
    alt={alt}
    class:list={["relative z-10 mx-auto rounded-lg shadow-2xl ring-1 ring-black/10", className]}
  />
</div>

<script>
  const VERT = `
    attribute vec2 a_position;
    void main() { gl_Position = vec4(a_position, 0.0, 1.0); }
  `;

  const FRAG = `
    #extension GL_OES_standard_derivatives : enable
    precision highp float;

    uniform vec2 u_resolution;
    uniform float u_time;
    uniform float u_scale;
    uniform int u_count;
    uniform float u_steps;
    uniform float u_softness;
    uniform vec3 u_colors[6];

    // 2D simplex noise — Ian McEwan, Ashima Arts (MIT)
    vec3 permute(vec3 x){ return mod(((x*34.0)+1.0)*x, 289.0); }
    float snoise(vec2 v){
      const vec4 C = vec4(0.211324865405187, 0.366025403784439,
                         -0.577350269189626, 0.024390243902439);
      vec2 i  = floor(v + dot(v, C.yy));
      vec2 x0 = v -   i + dot(i, C.xx);
      vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
      vec4 x12 = x0.xyxy + C.xxzz;
      x12.xy -= i1;
      i = mod(i, 289.0);
      vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0))
                             + i.x + vec3(0.0, i1.x, 1.0));
      vec3 m = max(0.5 - vec3(dot(x0,x0), dot(x12.xy,x12.xy), dot(x12.zw,x12.zw)), 0.0);
      m = m*m; m = m*m;
      vec3 x = 2.0 * fract(p * C.www) - 1.0;
      vec3 h = abs(x) - 0.5;
      vec3 ox = floor(x + 0.5);
      vec3 a0 = x - ox;
      m *= 1.79284291400159 - 0.85373472095314 * (a0*a0 + h*h);
      vec3 g;
      g.x  = a0.x  * x0.x  + h.x  * x0.y;
      g.yz = a0.yz * x12.xz + h.yz * x12.yw;
      return 130.0 * dot(m, g);
    }

    // 两层平移的噪声，制造流动、演化的效果
    float getNoise(vec2 uv, float t){
      float n = 0.5 * snoise(uv - vec2(0.0, 0.30 * t));
      n += 0.5 * snoise(2.0 * uv + vec2(0.0, 0.32 * t));
      return n;
    }

    // 把渐变位置量化成台阶，softness 控制台阶边缘柔和度
    float steppedSmooth(float m, float steps, float softness){
      float stepT = floor(m * steps) / steps;
      float f = m * steps - floor(m * steps);
      float fw = steps * fwidth(m);
      float smoothed = smoothstep(0.5 - softness, min(1.0, 0.5 + softness + fw), f);
      return stepT + smoothed / steps;
    }

    void main(){
      vec2 uv = (gl_FragCoord.xy - 0.5 * u_resolution) / u_resolution.y;
      vec2 shape_uv = uv * (2.2 / u_scale);
      float t = u_time;

      float shape = 0.5 + 0.5 * getNoise(shape_uv, t);

      float count = float(u_count);
      float mixer = (shape - 0.5 / count) * count;
      float steps = max(1.0, u_steps);
      float soft = 0.5 * u_softness;

      vec3 grad = u_colors[0];
      vec3 lastColor = u_colors[0];
      for (int i = 1; i < 6; i++) {
        if (i >= u_count) break;
        float localM = clamp(mixer - float(i - 1), 0.0, 1.0);
        localM = steppedSmooth(localM, steps, soft);
        grad = mix(grad, u_colors[i], localM);
        lastColor = u_colors[i];
      }

      // 首尾颜色环绕过渡
      if (mixer < 0.0 || mixer > (count - 1.0)) {
        float localM = mixer + 1.0;
        if (mixer > (count - 1.0)) localM = mixer - (count - 1.0);
        localM = steppedSmooth(localM, steps, soft);
        grad = mix(lastColor, u_colors[0], localM);
      }

      gl_FragColor = vec4(grad, 1.0);
    }
  `;

  function hexToRgb(hex: string): [number, number, number] {
    const h = hex.replace("#", "");
    const v = h.length === 3 ? h.split("").map((c) => c + c).join("") : h;
    const int = parseInt(v, 16);
    return [((int >> 16) & 255) / 255, ((int >> 8) & 255) / 255, (int & 255) / 255];
  }

  function compile(gl: WebGLRenderingContext, type: number, src: string) {
    const s = gl.createShader(type)!;
    gl.shaderSource(s, src);
    gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
      console.warn("shader compile error:", gl.getShaderInfoLog(s));
    }
    return s;
  }

  function initCanvas(container: HTMLElement) {
    const canvas = container.querySelector("canvas") as HTMLCanvasElement | null;
    if (!canvas || canvas.dataset.init) return;
    canvas.dataset.init = "1";

    const cfg = JSON.parse(container.dataset.shader || "{}");
    const colors: number[][] = (cfg.colors || ["#4449cf", "#ffd1e0", "#f94346"])
      .slice(0, 6)
      .map(hexToRgb);
    const scale = cfg.scale ?? 3;
    const speed = cfg.speed ?? 0.5;
    const steps = cfg.stepsPerColor ?? 2;
    const softness = cfg.softness ?? 0;

    const gl = canvas.getContext("webgl", { antialias: true, alpha: false }) as WebGLRenderingContext | null;
    if (!gl) return;
    gl.getExtension("OES_standard_derivatives");

    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl, gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, compile(gl, gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, "a_position");
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(prog, "u_resolution");
    const uTime = gl.getUniformLocation(prog, "u_time");
    gl.uniform1f(gl.getUniformLocation(prog, "u_scale"), scale);
    gl.uniform1i(gl.getUniformLocation(prog, "u_count"), colors.length);
    gl.uniform1f(gl.getUniformLocation(prog, "u_steps"), steps);
    gl.uniform1f(gl.getUniformLocation(prog, "u_softness"), softness);
    for (let i = 0; i < colors.length; i++) {
      gl.uniform3fv(gl.getUniformLocation(prog, `u_colors[${i}]`), colors[i]);
    }

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = Math.max(1, Math.floor(container.clientWidth * dpr));
      const h = Math.max(1, Math.floor(container.clientHeight * dpr));
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
        gl.viewport(0, 0, w, h);
        gl.uniform2f(uRes, w, h);
      }
    };

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let raf = 0;
    let running = false;
    const start = performance.now();

    const render = () => {
      resize();
      gl.uniform1f(uTime, ((performance.now() - start) / 1000) * speed);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      if (running && !reduce) raf = requestAnimationFrame(render);
    };

    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          if (!running) {
            running = true;
            if (reduce) render();
            else raf = requestAnimationFrame(render);
          }
        } else {
          running = false;
          cancelAnimationFrame(raf);
        }
      }
    });
    io.observe(container);
    if (typeof ResizeObserver !== "undefined") {
      new ResizeObserver(() => { if (running) resize(); }).observe(container);
    }
  }

  const boot = () => document.querySelectorAll<HTMLElement>(".shader-image").forEach(initCanvas);
  document.addEventListener("astro:page-load", boot);
  boot();
</script>
