---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
}

const { href, external, underline = true, ...rest } = Astro.props;
---

<a 
  href={href} 
  target={ external ? "_blank" : "_self" } 
  class={cn(
    "inline-block decoration-orange-600 dark:decoration-[#3aa99f] hover:decoration-black/25 hover:dark:decoration-[#3aa99f] text-[#6f6e69] hover:text-orange-600 hover:dark:text-[#3aa99f] hover:no-underline transition-colors duration-300 ease-in-out",
    underline && "underline underline-offset-4"
  )}
  {...rest}>
  <slot/>
</a>
